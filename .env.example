# --- Notion hozzáférés -------------------------------------------------------
# Belső integráció token: https://www.notion.so/profile/integrations
# Az integrációt meg kell osztani a workspace gyökér-oldalaival/teamspace-eivel,
# hogy "az egész Notionre" rálásson.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Tulajdonos azonosítása ("Albert saját feladatai") -----------------------
# A Notion-felhasználó e-mail címe. Ebből derül ki, mi számít "sajátnak"
# a people-típusú mezőkben. Vesszővel több is megadható.
OWNER_EMAIL=albert@sarospataki.hu
# A "Kapcsolati nyilvántartás"-ban a tulajdonost jelölő rekord neve (relation
# típusú Felelős mezőkhöz). Vesszővel több alias is megadható.
OWNER_NAMES=Albert Sárospataki,Sárospataki Albert,Albert

# --- Hozzáférés-védelem ------------------------------------------------------
# A felület a TELJES Notion-workspace tartalmát mutatja, ezért zárva az
# alapértelmezett: e két érték nélkül a szolgáltatás senkit nem enged be.
#
# Jelszó a belépéshez. Hosszú, egyedi, máshol nem használt legyen.
APP_PASSWORD=
# A munkamenet-sütik aláírókulcsa. Generáld így:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Megváltoztatása minden böngészőből kilépteti a belépett munkameneteket.
SESSION_SECRET=
# CSAK helyi fejlesztéshez: teljesen kikapcsolja a belépést. Éles üzemben soha.
AUTH_DISABLED=false

# --- Helyi adatbázis ---------------------------------------------------------
# Konténerben ez a csatolt kötet útvonala (a fly.toml szerint /data).
DATA_DIR=./data

# --- Szinkron ----------------------------------------------------------------
# Háttér-szinkron periódusa percben (0 = kikapcsolva, csak kézi/cron).
SYNC_INTERVAL_MINUTES=10
# Teljes újraolvasás periódusa órában (a napi inkrementális mellett).
FULL_SYNC_INTERVAL_HOURS=24
# Gépi hozzáférés az API-hoz, bejelentkezés nélkül — külső cronnak:
#   Authorization: Bearer <SYNC_SECRET>
# Ha üresen hagyod, csak belépett böngészőmenetből érhető el az API.
SYNC_SECRET=

# --- Visszaírás --------------------------------------------------------------
# true esetén a jóváhagyott javaslatok NEM íródnak vissza, csak naplózódnak.
WRITEBACK_DRY_RUN=false

# --- Megjelenítés ------------------------------------------------------------
TZ=Europe/Budapest
